# Mobile app build (staging). Copy to .env.staging (git-ignored), then: npm run build -- --mode staging
# The installed app has no proxy, so it needs the ABSOLUTE HTTPS address of the Aquila .NET API.
# Replace the placeholder. The app refuses to start while it is still a placeholder, plain HTTP, localhost or a temporary tunnel.
VITE_API_BASE_URL=https://CHANGE-ME-staging-api.example.com/api
