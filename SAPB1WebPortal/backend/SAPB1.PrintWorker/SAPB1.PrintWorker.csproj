    <Reference Include="CrystalDecisions.ReportSource"><HintPath>C:\Windows\Microsoft.NET\assembly\GAC_MSIL\CrystalDecisions.ReportSource\v4.0_13.0.4000.0__692fbea5521e1304\CrystalDecisions.ReportSource.dll</HintPath></Reference>
  </ItemGroup>
</Project>
