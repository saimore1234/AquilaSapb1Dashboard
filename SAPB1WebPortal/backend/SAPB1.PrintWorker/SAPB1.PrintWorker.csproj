<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework helper: SAP Crystal Reports' .NET runtime (13.x) does not run on modern .NET,
       so the ASP.NET Core API shells out to this exe to render the company's EXISTING SAP B1 .rpt layouts. -->
